  LYS["Lysine (protein-bound)"]
  SAM["S-adenosylmethionine"]
  TML["ε-N-trimethyl-L-lysine"]
  HTML["β-hydroxy-ε-N-trimethyl-L-lysine"]
  BBALD["γ-butyrobetaine aldehyde"]
  BB["γ-butyrobetaine"]
  CARN["L-carnitine"]
