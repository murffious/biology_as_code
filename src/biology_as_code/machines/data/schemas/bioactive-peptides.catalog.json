{
  "schema": "bac.BioactivePeptideCatalog/v1",
  "version": "1.0.0",
  "honesty": "OPEN",
  "note": "Peptide / collagen / bacteriocin home. Provenance tiers fix mis-filing under collagen bioactive or postbiotic. Wired into food_health_claims_500 bioactive_taxonomy (peptide_provenance_v1).",
  "provenance_tiers": {
    "intrinsic": {
      "label": "Present as eaten",
      "attachment": "food_node",
      "scoreable_on_food": true,
      "examples": ["carnosine", "anserine", "glutathione", "lunasin", "lycopene"]
    },
    "process_generated": {
      "label": "Formed before eating (fermentation / hydrolysis)",
      "attachment": "process_node",
      "scoreable_on_food": true,
      "score_belongs_to": "process_not_species",
      "examples": ["vpp_ipp", "collagen_peptide", "soy_process_peptides", "bacteriocin"]
    },
    "digestion_generated": {
      "label": "Formed in gut",
      "attachment": "host_food_edge",
      "scoreable_on_food": false,
      "same_shape_as": "urolithin_A_conversion",
      "examples": ["casomorphin", "gluten_exorphin", "ace_inhibitory_digest_peptides"]
    }
  },
  "bioavailability_filter": {
    "rule": "Most peptides hydrolyze to free AA (count as protein). Serum-surviving dietary peptides are often proline-rich (Pro-Hyp, VPP/IPP).",
    "gate_field": "proline_rich_gate",
    "honesty": "FLOW"
  },
  "splits": {
    "collagen": {
      "from": "collagen",
      "to": ["collagen_peptide", "collagen_protein"],
      "reason": "Hydrolysate peptides are process-generated; structural collagen is intrinsic protein."
    },
    "postbiotic": {
      "from": "postbiotic",
      "narrow_to": "postbiotic organic acids",
      "extract": "bacteriocin",
      "reason": "Bacteriocins must not be swallowed into generic postbiotic bucket."
    }
  },
